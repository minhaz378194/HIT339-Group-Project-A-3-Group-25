@model LibraTrack.Models.Borrower
@{
    ViewData["Title"] = "Register New Borrower";
}

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Catalog" asp-action="Index"><i class="bi bi-house"></i></a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Reception</a></li>
                <li class="breadcrumb-item active">Register Borrower</li>
            </ol>
        </nav>
        <h1 class="page-title">
            <i class="bi bi-person-plus-fill text-success me-2"></i>Register New Library Borrower
        </h1>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="lib-card lib-form">
                <div class="lib-card-header">
                    <i class="bi bi-person-vcard" style="color:var(--caramel);font-size:1.25rem;"></i>
                    <h3>Borrower Membership Information</h3>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="BorrowerCardNumber" class="form-label"></label>
                            <input asp-for="BorrowerCardNumber" class="form-control" placeholder="e.g. BRW-1009" />
                            <span asp-validation-for="BorrowerCardNumber" class="text-danger"></span>
                            <div class="form-text">Card number format: 'BRW-0000'.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="IsActive" class="form-label">Membership Status</label>
                            <div class="pt-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" asp-for="IsActive" />
                                    <label class="form-check-label" asp-for="IsActive">Active Member (Eligible to borrow)</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" placeholder="Given name" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" placeholder="Surname" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="patron@example.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" placeholder="+61 400 000 000" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Address" class="form-label"></label>
                            <textarea asp-for="Address" class="form-control" rows="2" placeholder="Full residential street address"></textarea>
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-lib-outline">
                            <i class="bi bi-arrow-left me-1"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-lib-primary">
                            <i class="bi bi-check-circle me-1"></i>Save & Register Patron
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
