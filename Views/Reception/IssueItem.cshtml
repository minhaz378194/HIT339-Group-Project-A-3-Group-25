@model LibraTrack.Models.ViewModels.ReceptionIssueViewModel
@{
    ViewData["Title"] = "Issue Item";
}

<!-- Page Header (Section 5 of design.md) -->
<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Catalog" asp-action="Index"><i class="bi bi-house me-1"></i>Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Reception</a></li>
                <li class="breadcrumb-item active" aria-current="page">Issue Item</li>
            </ol>
        </nav>
        <h1 class="page-title">
            <i class="bi bi-box-seam me-2"></i>Issue Item
        </h1>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-12">
            <div class="lib-card lib-form">
                <div class="lib-card-header">
                    <i class="bi bi-arrow-up-right-circle-fill" style="color:var(--caramel);font-size:1.25rem;"></i>
                    <h3>New Checkout / Loan Transaction</h3>
                </div>

                <form asp-action="IssueItem" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <!-- Borrower Search / Select -->
                        <div class="col-12">
                            <label class="form-label">Borrower (Search by Card Number or Name) *</label>
                            <select asp-for="BorrowerId" class="form-select select2" required>
                                <option value="">-- Choose a Registered Patron --</option>
                                @foreach (var b in Model.ActiveBorrowers)
                                {
                                    <option value="@b.Id" selected="@(b.Id == Model.BorrowerId)">
                                        @b.FullName (@b.BorrowerCardNumber) &bull; @b.Phone
                                    </option>
                                }
                            </select>
                            <div class="form-text mt-1">
                                Need to register a new member? <a asp-action="CreateBorrower" class="fw-bold">Register here</a>.
                            </div>
                        </div>

                        <!-- Item Search / Select -->
                        <div class="col-12">
                            <label class="form-label">Item Library Code (Select Available Item) *</label>
                            <select asp-for="ItemId" class="form-select select2" required>
                                <option value="">-- Choose Available Catalog Item --</option>
                                @foreach (var item in Model.AvailableItems)
                                {
                                    <option value="@item.Id" selected="@(item.Id == Model.ItemId)">
                                        [@item.LibraryCode] @item.Name (@item.ItemType)
                                    </option>
                                }
                            </select>
                            <div class="form-text mt-1">
                                Showing @Model.AvailableItems.Count available catalog items ready for checkout.
                            </div>
                        </div>

                        <!-- Manual Code Quick Search Input (Optional helper) -->
                        <div class="col-12">
                            <label class="form-label small text-muted">Or enter Library Code directly:</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                                <input asp-for="ItemLibraryCode" class="form-control font-monospace" placeholder="e.g. BOK-1001" />
                            </div>
                        </div>

                        <!-- Loan Dates -->
                        <div class="col-md-6 col-12">
                            <label asp-for="BorrowDate" class="form-label">Borrow Date *</label>
                            <input asp-for="BorrowDate" class="form-control" type="date" />
                            <span asp-validation-for="BorrowDate" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 col-12">
                            <label asp-for="DueDate" class="form-label">Due Date * (Default: 14 Days)</label>
                            <input asp-for="DueDate" class="form-control" type="date" />
                            <span asp-validation-for="DueDate" class="text-danger"></span>
                        </div>

                        <!-- Staff Notes -->
                        <div class="col-12">
                            <label asp-for="Notes" class="form-label">Staff Notes (Optional)</label>
                            <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Special handling notes, borrower request, etc..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-lib-outline">
                            <i class="bi bi-arrow-left me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-lib-primary px-4">
                            <i class="bi bi-check2-circle me-1"></i> Confirm & Issue Item
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
