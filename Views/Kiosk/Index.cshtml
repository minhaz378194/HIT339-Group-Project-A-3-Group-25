@{
    Layout = "_KioskLayout";
    ViewData["Title"] = "Welcome to Self-Service Kiosk";
}

<div class="row justify-content-center">
    <div class="col-lg-10 text-center mb-4">
        @if (TempData["KioskMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm fs-5 p-3 mb-4 rounded-4" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-4"></i>@TempData["KioskMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["KioskAlert"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show shadow-sm fs-5 p-3 mb-4 rounded-4" role="alert">
                <i class="bi bi-clock-history me-2 fs-4"></i>@TempData["KioskAlert"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <h1 class="display-4 fw-bold text-dark mb-2" style="font-family: 'Playfair Display', serif;">
            Welcome to the Library Kiosk
        </h1>
        <p class="fs-4 text-muted">
            Touch an option below or scan your library borrower card to get started.
        </p>
    </div>

    <!-- Screen 1: Two Big Buttons (Requirement 1) -->
    <div class="col-md-6 col-lg-5 mb-4">
        <a asp-action="Login" asp-route-target="checkout" class="btn-kiosk-action btn-kiosk-checkout w-100">
            <i class="bi bi-box-arrow-up-right"></i>
            <span>Check Out</span>
            <small class="fs-5 opacity-75 fw-normal mt-2">Borrow books, music & toys</small>
        </a>
    </div>

    <div class="col-md-6 col-lg-5 mb-4">
        <a asp-action="Login" asp-route-target="account" class="btn-kiosk-action btn-kiosk-account w-100">
            <i class="bi bi-person-badge"></i>
            <span>My Account</span>
            <small class="fs-5 opacity-75 fw-normal mt-2">View loans, due dates & holds</small>
        </a>
    </div>

    <!-- Quick Help & Instructions Card -->
    <div class="col-lg-10 mt-3">
        <div class="kiosk-card bg-white p-4 text-center">
            <div class="row align-items-center g-3">
                <div class="col-md-4 text-md-start">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-upc-scan fs-1 text-primary"></i>
                        <div>
                            <strong class="d-block text-dark fs-5">Barcode Scanner Ready</strong>
                            <span class="text-muted small">Scan card or item at any time</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-md-center">
                    <div class="d-flex align-items-center justify-content-center gap-3">
                        <i class="bi bi-shield-lock-fill fs-1 text-warning"></i>
                        <div class="text-start">
                            <strong class="d-block text-dark fs-5">Secure PIN Protected</strong>
                            <span class="text-muted small">4-digit PIN secures your account</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-md-end">
                    <div class="d-flex align-items-center justify-content-md-end gap-3">
                        <i class="bi bi-info-circle-fill fs-1 text-muted"></i>
                        <div class="text-start text-md-end">
                            <strong class="d-block text-dark fs-5">Need Help?</strong>
                            <span class="text-muted small">Please visit reception staff</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
