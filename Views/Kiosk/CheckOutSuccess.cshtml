@model LibraTrack.Models.Loan
@{
    Layout = "_KioskLayout";
    ViewData["Title"] = "Checkout Successful";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="kiosk-card text-center p-5">
            <div class="text-success mb-3">
                <i class="bi bi-check-circle-fill display-1"></i>
            </div>

            <h1 class="display-5 fw-bold text-success mb-2" style="font-family: 'Playfair Display', serif;">
                Checked Out Successfully!
            </h1>
            <p class="fs-4 text-muted mb-4">
                Thank you, <strong>@Model.Borrower.FullName</strong>. Please collect your item.
            </p>

            <!-- Loan Details Summary Box -->
            <div class="p-4 bg-light rounded-4 border mb-4 text-start">
                <div class="row align-items-center g-3">
                    <div class="col-sm-8">
                        <span class="badge bg-secondary fs-6 mb-1">@Model.Item.ItemType</span>
                        <h3 class="fw-bold text-dark mb-1">@Model.Item.Name</h3>
                        <div class="text-muted font-monospace">
                            <code>@Model.Item.LibraryCode</code> &bull; @(Model.Item.Branch?.Name ?? "Main Branch")
                        </div>
                    </div>
                    <div class="col-sm-4 text-sm-end">
                        <span class="text-muted d-block small text-uppercase fw-semibold">Due Date</span>
                        <span class="fs-4 fw-bold text-primary d-block">
                            @Model.DueDate.ToString("dd MMM yyyy")
                        </span>
                        <small class="text-muted">14-day loan period</small>
                    </div>
                </div>
            </div>

            <div class="alert alert-info d-flex align-items-center mb-5 rounded-4 fs-6" role="alert">
                <i class="bi bi-envelope-check-fill fs-3 me-3 text-info"></i>
                <div class="text-start">
                    <strong>Electronic Receipt Dispatched:</strong> A borrowing confirmation notice has been simulated and sent to <strong>@Model.Borrower.Email</strong>.
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="row g-3">
                <div class="col-md-6">
                    <a asp-action="CheckOut" class="btn btn-success btn-lg w-100 py-3 fs-4 fw-bold rounded-pill shadow">
                        <i class="bi bi-upc-scan me-2"></i>Check Out Another Item
                    </a>
                </div>
                <div class="col-md-6">
                    <a asp-action="Account" class="btn btn-primary btn-lg w-100 py-3 fs-4 fw-bold rounded-pill shadow">
                        <i class="bi bi-person-badge me-2"></i>View My Account
                    </a>
                </div>
                <div class="col-12 mt-3">
                    <a asp-action="Finish" class="btn btn-outline-danger btn-lg w-100 py-3 fs-4 fw-bold rounded-pill">
                        <i class="bi bi-box-arrow-right me-2"></i>Finish & Exit Session
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
