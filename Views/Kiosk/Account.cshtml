@model LibraTrack.Models.ViewModels.KioskAccountViewModel
@{
    Layout = "_KioskLayout";
    ViewData["Title"] = "My Account Overview";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="kiosk-card p-4 p-md-5">
            <!-- Patron Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 border-bottom pb-3">
                <div>
                    <span class="badge bg-primary px-3 py-2 fs-6 rounded-pill text-uppercase mb-2">Member Dashboard</span>
                    <h2 class="display-6 fw-bold text-dark mb-1" style="font-family: 'Playfair Display', serif;">
                        @Model.Borrower.FullName
                    </h2>
                    <div class="text-muted fs-6">
                        <i class="bi bi-person-vcard text-primary me-1"></i>Card: <strong>@Model.Borrower.BorrowerCardNumber</strong> &bull;
                        <i class="bi bi-envelope text-secondary me-1"></i>@Model.Borrower.Email
                    </div>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-action="CheckOut" class="btn btn-success px-3 py-2 rounded-pill fs-6 fw-semibold shadow-sm">
                        <i class="bi bi-upc-scan me-1"></i>Check Out Items
                    </a>
                    <a asp-action="Finish" class="btn btn-kiosk-finish py-2 px-3 fs-6">
                        <i class="bi bi-box-arrow-right me-1"></i>Finish
                    </a>
                </div>
            </div>

            <!-- Fines Warning (Requirement 4) -->
            @if (Model.TotalFinesOwed > 0)
            {
                <div class="alert alert-danger d-flex align-items-center p-3 rounded-4 mb-4" role="alert">
                    <i class="bi bi-cash-coin fs-1 me-3 text-danger"></i>
                    <div>
                        <h4 class="alert-heading fw-bold mb-1">Outstanding Fines: $@Model.TotalFinesOwed.ToString("F2")</h4>
                        <span class="fs-6">You have unpaid overdue library fines. Please speak with reception staff to settle your balance.</span>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-success d-flex align-items-center p-3 rounded-4 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill fs-2 me-3 text-success"></i>
                    <div>
                        <strong>Good Standing:</strong> You have no outstanding fines or overdue penalties.
                    </div>
                </div>
            }

            <!-- 1. Active Loans Section (Requirement 4) -->
            <div class="mb-5">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="fw-bold text-dark mb-0">
                        <i class="bi bi-book-half text-primary me-2"></i>Active Loans (@Model.ActiveLoans.Count)
                    </h3>
                </div>

                @if (Model.ActiveLoans.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Item Title</th>
                                    <th>Library Code</th>
                                    <th>Borrow Date</th>
                                    <th>Due Date</th>
                                    <th class="text-end">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var loan in Model.ActiveLoans)
                                {
                                    <tr class="@(loan.IsOverdue ? "table-danger" : (loan.IsDueSoon ? "table-warning" : ""))">
                                        <td>
                                            <div class="fw-bold fs-5 text-dark">@loan.Item.Name</div>
                                            <div class="small text-muted">
                                                <span class="badge bg-secondary">@loan.Item.ItemType</span>
                                                &bull; @(loan.Item.Branch?.Name ?? "Main Branch")
                                            </div>
                                        </td>
                                        <td>
                                            <code class="fs-6">@loan.Item.LibraryCode</code>
                                        </td>
                                        <td class="text-muted">
                                            @loan.BorrowDate.ToString("dd MMM yyyy")
                                        </td>
                                        <td>
                                            <div class="fw-bold fs-5 @(loan.IsOverdue ? "text-danger" : (loan.IsDueSoon ? "text-warning text-dark" : "text-primary"))">
                                                @loan.DueDate.ToString("dd MMM yyyy")
                                            </div>
                                            @if (loan.IsOverdue)
                                            {
                                                <small class="text-danger fw-bold">
                                                    @loan.OverdueDays day(s) overdue (Fine: $@loan.FineAmount.ToString("F2"))
                                                </small>
                                            }
                                            else if (loan.IsDueSoon)
                                            {
                                                <small class="text-warning text-dark fw-semibold">Due in @loan.DaysUntilDue day(s)</small>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (loan.IsOverdue)
                                            {
                                                <span class="badge bg-danger fs-6 px-3 py-2">Overdue</span>
                                            }
                                            else if (loan.IsDueSoon)
                                            {
                                                <span class="badge bg-warning text-dark fs-6 px-3 py-2">Due Soon</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success fs-6 px-3 py-2">Active</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 bg-light rounded-4 text-center text-muted">
                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                        <span class="fs-5">You currently have no active borrowed items.</span>
                    </div>
                }
            </div>

            <!-- 2. Active Reservations Section (Requirement 4) -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="fw-bold text-dark mb-0">
                        <i class="bi bi-bookmark-star text-warning me-2"></i>Active Holds & Reservations (@Model.Reservations.Count)
                    </h3>
                </div>

                @if (Model.Reservations.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Reserved Item</th>
                                    <th>Hold Status</th>
                                    <th>Hold Timeline</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var res in Model.Reservations)
                                {
                                    <tr class="@(res.Status == LibraTrack.Models.ReservationStatus.Ready ? "table-success" : "")">
                                        <td>
                                            <div class="fw-bold fs-5 text-dark">@res.Item.Name</div>
                                            <div class="small text-muted font-monospace">
                                                <code>@res.Item.LibraryCode</code> &bull; Location: @(res.Item.Branch?.Name ?? "Main Branch")
                                            </div>
                                        </td>
                                        <td>
                                            @if (res.Status == LibraTrack.Models.ReservationStatus.Ready)
                                            {
                                                <span class="badge bg-success fs-6 px-3 py-2">
                                                    <i class="bi bi-box2-heart me-1"></i>Ready on Hold Shelf
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                                                    <i class="bi bi-people me-1"></i>Queue Position #@res.QueuePosition
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (res.Status == LibraTrack.Models.ReservationStatus.Ready)
                                            {
                                                <div class="text-danger fw-bold fs-6">
                                                    <i class="bi bi-clock-history me-1"></i>Pick up by: @(res.ExpiresAt?.ToString("dd MMM yyyy HH:mm") ?? "3 days")
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Placed on @res.CreatedAt.ToString("dd MMM yyyy")</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 bg-light rounded-4 text-center text-muted">
                        <i class="bi bi-bookmark-x fs-2 d-block mb-2"></i>
                        <span class="fs-5">You have no active hold requests or waitlist reservations.</span>
                    </div>
                }
            </div>

            <!-- Bottom Action Footer (Responsive touch buttons) -->
            <div class="row g-3 pt-4 border-top mt-4">
                <div class="col-12 col-md-6">
                    <a asp-action="CheckOut" class="btn btn-success btn-lg w-100 py-3 px-3 fs-5 fs-md-4 fw-bold rounded-pill shadow-sm d-flex align-items-center justify-content-center text-center">
                        <i class="bi bi-upc-scan me-2"></i><span>Check Out Items</span>
                    </a>
                </div>
                <div class="col-12 col-md-6">
                    <a asp-action="Finish" class="btn btn-outline-danger btn-lg w-100 py-3 px-3 fs-5 fs-md-4 fw-bold rounded-pill d-flex align-items-center justify-content-center text-center">
                        <i class="bi bi-box-arrow-right me-2"></i><span>Finish & Exit</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
