@model LibraTrack.Models.Item
@{
    ViewData["Title"] = $"Delete Item: {Model.Name}";
}

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Catalog" asp-action="Index"><i class="bi bi-house"></i></a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Admin Items</a></li>
                <li class="breadcrumb-item active">Delete Item</li>
            </ol>
        </nav>
        <h1 class="page-title">
            <i class="bi bi-trash-fill text-danger me-2"></i>Delete Item from Catalog
        </h1>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="lib-card border-danger border-opacity-50">
                <div class="lib-card-header bg-danger bg-opacity-10 border-danger border-opacity-25 rounded p-3 mb-3">
                    <i class="bi bi-exclamation-octagon-fill text-danger fs-4"></i>
                    <h3 class="text-danger mb-0 fs-5">Confirm Permanent Item Deletion</h3>
                </div>

                <p class="text-muted mb-4">
                    Are you sure you want to permanently delete this item from the library catalog? This action will remove the record from the database.
                </p>

                <div class="p-3 bg-light rounded mb-4 border">
                    <div class="row g-2 small">
                        <div class="col-sm-4 text-muted">Library Code:</div>
                        <div class="col-sm-8 fw-bold"><code>@Model.LibraryCode</code></div>

                        <div class="col-sm-4 text-muted">Item Title:</div>
                        <div class="col-sm-8 fw-bold">@Model.Name</div>

                        <div class="col-sm-4 text-muted">Item Type:</div>
                        <div class="col-sm-8"><span class="type-badge type-@Model.ItemType.ToString().ToLower()">@Model.ItemType</span></div>

                        <div class="col-sm-4 text-muted">Current Status:</div>
                        <div class="col-sm-8"><span class="status-badge status-@Model.Status.ToString().ToLower()">@Model.Status</span></div>

                        <div class="col-sm-4 text-muted">Replacement Value:</div>
                        <div class="col-sm-8">$@Model.ReplacementCost.ToString("F2")</div>
                    </div>
                </div>

                @if (Model.Status == LibraTrack.Models.ItemStatus.Borrowed)
                {
                    <div class="alert alert-warning small mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        <strong>Warning:</strong> This item is currently marked as <strong>Borrowed</strong>. You should process its return through Reception before deleting it.
                    </div>
                }

                <form asp-action="Delete" method="post" class="d-flex justify-content-between align-items-center pt-3 border-top">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-lib-outline">
                        <i class="bi bi-arrow-left me-1"></i>Cancel & Keep
                    </a>
                    <button type="submit" class="btn btn-lib-danger">
                        <i class="bi bi-trash me-1"></i>Confirm & Delete Item
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
