@model LibraTrack.Models.Toy
@{
    ViewData["Title"] = $"Edit Toy: {Model.Name}";
}

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Catalog" asp-action="Index"><i class="bi bi-house me-1"></i>Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" asp-route-tab="toys">Admin</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit Toy</li>
            </ol>
        </nav>
        <h1 class="page-title">
            <i class="bi bi-pencil-square text-primary me-2"></i>Edit Toy / Game
        </h1>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="lib-card lib-form">
                <div class="lib-card-header">
                    <i class="bi bi-dice-5" style="color:var(--toy-color);font-size:1.25rem;"></i>
                    <h3>Modify Toy #@Model.Id (<code>@Model.LibraryCode</code>)</h3>
                </div>

                <form asp-action="EditToy" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="LibraryCode" class="form-label"></label>
                            <input asp-for="LibraryCode" class="form-control" />
                            <span asp-validation-for="LibraryCode" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<LibraTrack.Models.ItemStatus>()"></select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Name" class="form-label">Toy / Game Name</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ToyType" class="form-label"></label>
                            <input asp-for="ToyType" class="form-control" />
                            <span asp-validation-for="ToyType" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Brand" class="form-label"></label>
                            <input asp-for="Brand" class="form-control" />
                            <span asp-validation-for="Brand" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="RecommendedAgeMin" class="form-label"></label>
                            <input asp-for="RecommendedAgeMin" class="form-control" />
                            <span asp-validation-for="RecommendedAgeMin" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="RecommendedAgeMax" class="form-label"></label>
                            <input asp-for="RecommendedAgeMax" class="form-control" />
                            <span asp-validation-for="RecommendedAgeMax" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PieceCount" class="form-label"></label>
                            <input asp-for="PieceCount" class="form-control" />
                            <span asp-validation-for="PieceCount" class="text-danger"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="ReplacementCost" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="ReplacementCost" class="form-control" step="0.01" />
                            </div>
                            <span asp-validation-for="ReplacementCost" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="ImageUrl" class="form-label"></label>
                            <input asp-for="ImageUrl" class="form-control" />
                            <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="SafetyNotes" class="form-label"></label>
                            <input asp-for="SafetyNotes" class="form-control" />
                            <span asp-validation-for="SafetyNotes" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a asp-action="Index" asp-route-tab="toys" class="btn btn-lib-outline">
                            <i class="bi bi-arrow-left me-1"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-lib-primary" style="background-color:var(--toy-color);">
                            <i class="bi bi-check-lg me-1"></i>Update Toy Item
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
