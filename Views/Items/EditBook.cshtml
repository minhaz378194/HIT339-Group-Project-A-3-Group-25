@model LibraTrack.Models.Book
@{
    ViewData["Title"] = $"Edit Book: {Model.Name}";
}

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Catalog" asp-action="Index"><i class="bi bi-house me-1"></i>Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" asp-route-tab="books">Admin</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit Book</li>
            </ol>
        </nav>
        <h1 class="page-title">
            <i class="bi bi-pencil-square text-primary me-2"></i>Edit Book
        </h1>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="lib-card lib-form">
                <div class="lib-card-header">
                    <i class="bi bi-pencil" style="color:var(--caramel);font-size:1.25rem;"></i>
                    <h3>Modify Book #@Model.Id (<code>@Model.LibraryCode</code>)</h3>
                </div>

                <form asp-action="EditBook" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="LibraryCode" class="form-label"></label>
                            <input asp-for="LibraryCode" class="form-control" />
                            <span asp-validation-for="LibraryCode" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<LibraTrack.Models.ItemStatus>()"></select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Name" class="form-label">Book Title</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Author" class="form-label"></label>
                            <input asp-for="Author" class="form-control" />
                            <span asp-validation-for="Author" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Genre" class="form-label"></label>
                            <input asp-for="Genre" class="form-control" />
                            <span asp-validation-for="Genre" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ISBN" class="form-label"></label>
                            <input asp-for="ISBN" class="form-control" />
                            <span asp-validation-for="ISBN" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PublicationYear" class="form-label"></label>
                            <input asp-for="PublicationYear" class="form-control" />
                            <span asp-validation-for="PublicationYear" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PageCount" class="form-label"></label>
                            <input asp-for="PageCount" class="form-control" />
                            <span asp-validation-for="PageCount" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Publisher" class="form-label"></label>
                            <input asp-for="Publisher" class="form-control" />
                            <span asp-validation-for="Publisher" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ReplacementCost" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="ReplacementCost" class="form-control" step="0.01" />
                            </div>
                            <span asp-validation-for="ReplacementCost" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="BranchId" class="form-label">Library Branch Location</label>
                            <select asp-for="BranchId" class="form-select">
                                @if (ViewBag.Branches is IEnumerable<LibraTrack.Models.Branch> branchList)
                                {
                                    foreach (var b in branchList)
                                    {
                                        <option value="@b.Id" selected="@(Model.BranchId == b.Id ? "selected" : null)">@b.Name (@b.BranchCode)</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="BranchId" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="ImageUrl" class="form-label"></label>
                            <input asp-for="ImageUrl" class="form-control" />
                            <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a asp-action="Index" asp-route-tab="books" class="btn btn-lib-outline">
                            <i class="bi bi-arrow-left me-1"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-lib-primary">
                            <i class="bi bi-check-lg me-1"></i>Update Book
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
