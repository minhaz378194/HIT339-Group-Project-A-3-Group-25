@{
    ViewData["Title"] = "Access Denied";
}

<!-- Page Header -->
<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Catalog" asp-action="Index"><i class="bi bi-house me-1"></i>Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Access Denied</li>
            </ol>
        </nav>
        <h1 class="page-title">
            <i class="bi bi-shield-x text-danger me-2"></i>Access Denied
        </h1>
    </div>
</div>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-12">
            <div class="lib-card text-center p-5">
                <div class="mb-3">
                    <i class="bi bi-shield-lock-fill" style="font-size: 4rem; color: var(--destroyed);"></i>
                </div>
                <h2 class="mb-2">Access Denied</h2>
                <p class="fs-5 text-muted mb-4">
                    You do not have permission to view this page.
                </p>
                <div class="p-3 bg-light rounded text-start small mb-4">
                    <div class="d-flex align-items-center gap-2 text-muted">
                        <i class="bi bi-info-circle-fill text-primary"></i>
                        <span>This section is restricted to authorized staff roles. Please return to your designated dashboard or log in with the required credentials.</span>
                    </div>
                </div>
                <div class="d-flex justify-content-center flex-wrap gap-2">
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Items" asp-action="Index" class="btn btn-lib-primary">
                            <i class="bi bi-shield-check me-1"></i>Back to Admin Dashboard
                        </a>
                    }
                    else if (User.IsInRole("Reception"))
                    {
                        <a asp-controller="Borrowers" asp-action="Index" class="btn btn-lib-primary">
                            <i class="bi bi-person-badge me-1"></i>Back to Reception Dashboard
                        </a>
                    }
                    else if (User.IsInRole("Manager"))
                    {
                        <a asp-controller="Manager" asp-action="Index" class="btn btn-lib-primary">
                            <i class="bi bi-graph-up me-1"></i>Back to Manager Dashboard
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Catalog" asp-action="Index" class="btn btn-lib-primary">
                            <i class="bi bi-compass me-1"></i>Back to Catalog
                        </a>
                    }

                    <a asp-controller="Account" asp-action="Login" class="btn btn-lib-outline">
                        <i class="bi bi-arrow-repeat me-1"></i>Switch Staff Account
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
