@model LibraTrack.Models.ViewModels.FineRevenueAuditReportViewModel
@{
    ViewData["Title"] = "Fine Revenue Audit Report";
}

<div class="container py-4">
    <!-- Header Section with Export Actions -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold mb-1 text-primary">
                <i class="bi bi-cash-coin me-2"></i>Fine Revenue Audit Report
            </h2>
            <p class="text-muted mb-0">
                Audit fine assessments, overdue penalties, and revenue collections by branch.
            </p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            <a asp-action="ExportFineRevenueAuditCsv" 
               asp-route-fromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))" 
               asp-route-toDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))" 
               asp-route-branchId="@Model.SelectedBranchId" 
               class="btn btn-outline-success shadow-sm">
                <i class="bi bi-filetype-csv me-1"></i>Export CSV
            </a>
            <a asp-action="ExportFineRevenueAuditPdf" 
               asp-route-fromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))" 
               asp-route-toDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))" 
               asp-route-branchId="@Model.SelectedBranchId" 
               class="btn btn-outline-danger shadow-sm">
                <i class="bi bi-filetype-pdf me-1"></i>Export PDF
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Dashboard
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-light">
        <div class="card-body p-3">
            <form asp-action="FineRevenueAudit" method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Branch Location</label>
                    <select name="branchId" class="form-select">
                        <option value="">All Branches</option>
                        @foreach (var br in Model.Branches)
                        {
                            <option value="@br.Id" selected="@(Model.SelectedBranchId == br.Id)">
                                @br.Name (@br.BranchCode)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">From Date</label>
                    <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">To Date</label>
                    <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel me-1"></i>Apply Filter
                    </button>
                    <a asp-action="FineRevenueAudit" class="btn btn-outline-secondary" title="Reset filter">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary Block with Totals -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-primary bg-white h-100">
                <div class="card-body p-3">
                    <div class="text-muted small text-uppercase fw-semibold">Total Incidents</div>
                    <div class="h3 fw-bold mb-0 text-primary">@Model.TotalFinesCount</div>
                    <small class="text-muted">Branch: @Model.SelectedBranchName</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-warning bg-white h-100">
                <div class="card-body p-3">
                    <div class="text-muted small text-uppercase fw-semibold">Total Assessed</div>
                    <div class="h3 fw-bold mb-0 text-warning">$@Model.TotalFinesAssessed.ToString("F2")</div>
                    <small class="text-muted">Overall penalties</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-success bg-white h-100">
                <div class="card-body p-3">
                    <div class="text-muted small text-uppercase fw-semibold">Collected / Paid</div>
                    <div class="h3 fw-bold mb-0 text-success">$@Model.TotalFinesCollected.ToString("F2")</div>
                    <small class="text-muted">@Model.PaidCount settled incident(s)</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-danger bg-white h-100">
                <div class="card-body p-3">
                    <div class="text-muted small text-uppercase fw-semibold">Outstanding / Unpaid</div>
                    <div class="h3 fw-bold mb-0 text-danger">$@Model.TotalFinesOutstanding.ToString("F2")</div>
                    <small class="text-muted">@Model.UnpaidCount pending collection</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Report Table -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold text-dark">
                <i class="bi bi-journal-text me-2 text-primary"></i>Fine Transactions Audit
            </h5>
            <span class="badge bg-secondary-subtle text-secondary">@Model.Rows.Count Records</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 70px;"># Loan</th>
                        <th scope="col" style="width: 110px;">Date</th>
                        <th scope="col">Patron</th>
                        <th scope="col" style="width: 110px;">Item Code</th>
                        <th scope="col">Item Title</th>
                        <th scope="col" style="width: 170px;">Branch</th>
                        <th scope="col" style="width: 110px;" class="text-end">Overdue</th>
                        <th scope="col" style="width: 110px;" class="text-end">Fine ($)</th>
                        <th scope="col" style="width: 110px;" class="text-center">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Rows.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                No fine revenue records found matching the specified filters.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td class="fw-bold text-muted">#@r.LoanId</td>
                                <td>@r.IncidentDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <div class="fw-semibold text-dark">@r.BorrowerName</div>
                                    <small class="text-muted">@r.BorrowerCardNumber</small>
                                </td>
                                <td><code class="fw-bold">@r.LibraryCode</code></td>
                                <td class="text-dark">@r.ItemName</td>
                                <td>
                                    <span class="fw-semibold text-dark">@r.BranchName</span>
                                </td>
                                <td class="text-end">@r.DaysOverdue day(s)</td>
                                <td class="text-end fw-bold text-dark">$@r.FineAmount.ToString("F2")</td>
                                <td class="text-center">
                                    @if (r.IsPaid)
                                    {
                                        <span class="badge bg-success px-2 py-1">
                                            <i class="bi bi-check2"></i> Paid
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger px-2 py-1">
                                            <i class="bi bi-clock-history"></i> Unpaid
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-light py-2 text-muted small d-flex justify-content-between">
            <span>Showing @Model.Rows.Count fine record(s)</span>
            <span>Branch: @Model.SelectedBranchName</span>
        </div>
    </div>
</div>
