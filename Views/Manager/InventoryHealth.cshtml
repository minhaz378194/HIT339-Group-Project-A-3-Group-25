@model LibraTrack.Models.ViewModels.InventoryHealthReportViewModel
@{
    ViewData["Title"] = "Inventory Health Report";
}

<div class="container py-4">
    <!-- Header Section with Export Actions -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold mb-1 text-primary">
                <i class="bi bi-box-seam me-2"></i>Inventory Health & Asset Report
            </h2>
            <p class="text-muted mb-0">
                Fleet condition, asset replacement valuation, and catalog circulation health by branch.
            </p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            <a asp-action="ExportInventoryHealthCsv" 
               asp-route-fromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))" 
               asp-route-toDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))" 
               asp-route-branchId="@Model.SelectedBranchId" 
               class="btn btn-outline-success shadow-sm">
                <i class="bi bi-filetype-csv me-1"></i>Export CSV
            </a>
            <a asp-action="ExportInventoryHealthPdf" 
               asp-route-fromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))" 
               asp-route-toDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))" 
               asp-route-branchId="@Model.SelectedBranchId" 
               class="btn btn-outline-danger shadow-sm">
                <i class="bi bi-filetype-pdf me-1"></i>Export PDF
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Dashboard
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-light">
        <div class="card-body p-3">
            <form asp-action="InventoryHealth" method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Branch Location</label>
                    <select name="branchId" class="form-select">
                        <option value="">All Branches</option>
                        @foreach (var br in Model.Branches)
                        {
                            <option value="@br.Id" selected="@(Model.SelectedBranchId == br.Id)">
                                @br.Name (@br.BranchCode)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Catalog Added After</label>
                    <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Catalog Added Before</label>
                    <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel me-1"></i>Apply Filter
                    </button>
                    <a asp-action="InventoryHealth" class="btn btn-outline-secondary" title="Reset filter">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary Block with Totals -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-2">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-primary bg-white h-100">
                <div class="card-body p-3">
                    <div class="text-muted small text-uppercase fw-semibold">Total Items</div>
                    <div class="h4 fw-bold mb-0 text-primary">@Model.TotalItemsCount</div>
                    <small class="text-muted">In scope</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-success bg-white h-100">
                <div class="card-body p-3">
                    <div class="text-muted small text-uppercase fw-semibold">Available</div>
                    <div class="h4 fw-bold mb-0 text-success">@Model.AvailableCount</div>
                    <small class="text-muted">On shelves</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-warning bg-white h-100">
                <div class="card-body p-3">
                    <div class="text-muted small text-uppercase fw-semibold">Borrowed</div>
                    <div class="h4 fw-bold mb-0 text-warning">@Model.BorrowedCount</div>
                    <small class="text-muted">In circulation</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-danger bg-white h-100">
                <div class="card-body p-3">
                    <div class="text-muted small text-uppercase fw-semibold">Damaged/Lost</div>
                    <div class="h4 fw-bold mb-0 text-danger">@(Model.DamagedCount + Model.DestroyedCount)</div>
                    <small class="text-muted">Require repair/replace</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-info bg-white h-100">
                <div class="card-body p-3">
                    <div class="text-muted small text-uppercase fw-semibold">Asset Value</div>
                    <div class="h4 fw-bold mb-0 text-info">$@Model.TotalAssetValue.ToString("F0")</div>
                    <small class="text-muted">Total replacement</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-secondary bg-white h-100">
                <div class="card-body p-3">
                    <div class="text-muted small text-uppercase fw-semibold">Damage Cost</div>
                    <div class="h4 fw-bold mb-0 text-danger">$@Model.DamageLiabilityCost.ToString("F0")</div>
                    <small class="text-muted">Liability exposure</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Report Table -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold text-dark">
                <i class="bi bi-stack me-2 text-primary"></i>Catalog Assets Condition Audit
            </h5>
            <span class="badge bg-secondary-subtle text-secondary">@Model.Rows.Count Items</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 60px;"># ID</th>
                        <th scope="col" style="width: 110px;">Code</th>
                        <th scope="col">Title</th>
                        <th scope="col" style="width: 100px;">Category</th>
                        <th scope="col" style="width: 170px;">Branch Location</th>
                        <th scope="col" style="width: 110px;" class="text-center">Status</th>
                        <th scope="col" style="width: 130px;" class="text-end">Replacement ($)</th>
                        <th scope="col" style="width: 110px;" class="text-end">Circulation</th>
                        <th scope="col" style="width: 110px;">Added Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Rows.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                No catalog items found matching the specified filters.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td class="fw-bold text-muted">#@r.ItemId</td>
                                <td><code class="fw-bold">@r.LibraryCode</code></td>
                                <td class="fw-semibold text-dark">@r.ItemName</td>
                                <td>
                                    <span class="badge bg-light text-dark border">@r.ItemCategory</span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@r.BranchName</span>
                                </td>
                                <td class="text-center">
                                    @if (r.Status == LibraTrack.Models.ItemStatus.Available)
                                    {
                                        <span class="badge bg-success px-2 py-1">Available</span>
                                    }
                                    else if (r.Status == LibraTrack.Models.ItemStatus.Borrowed)
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1">Borrowed</span>
                                    }
                                    else if (r.Status == LibraTrack.Models.ItemStatus.Damaged)
                                    {
                                        <span class="badge bg-danger px-2 py-1">Damaged</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark px-2 py-1">Destroyed</span>
                                    }
                                </td>
                                <td class="text-end fw-semibold text-dark">$@r.ReplacementCost.ToString("F2")</td>
                                <td class="text-end">@r.TimesBorrowed loan(s)</td>
                                <td>@r.AddedDate.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-light py-2 text-muted small d-flex justify-content-between">
            <span>Showing @Model.Rows.Count asset item(s)</span>
            <span>Branch: @Model.SelectedBranchName</span>
        </div>
    </div>
</div>
