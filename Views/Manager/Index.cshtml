@model LibraTrack.Models.ViewModels.ManagerDashboardViewModel
@{
    ViewData["Title"] = "Manager Dashboard";
}

<!-- Page Header (Section 5 of design.md) -->
<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Catalog" asp-action="Index"><i class="bi bi-house me-1"></i>Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Manager</li>
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h1 class="page-title">
                <i class="bi bi-graph-up me-2"></i>Manager Dashboard
            </h1>
            <a asp-action="Statistics" class="btn btn-lib-outline">
                <i class="bi bi-graph-up-arrow me-1"></i> View Full Statistics
            </a>
        </div>
    </div>
</div>

<div class="container pb-5">
    <!-- 4 Live Stat Cards (Section 7 & 14 of design.md) -->
    <div class="row g-3 mb-4">
        <!-- 1. Total Loans -->
        <div class="col-xl-3 col-md-6 col-12">
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(46,109,164,0.12); color:var(--borrowed);">
                    <i class="bi bi-arrow-left-right"></i>
                </div>
                <div class="stat-info">
                    <div class="stat-number">@Model.TotalLoansCount</div>
                    <div class="stat-label">Total Loans</div>
                </div>
            </div>
        </div>

        <!-- 2. Active Borrows -->
        <div class="col-xl-3 col-md-6 col-12">
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(74,124,89,0.12); color:var(--available);">
                    <i class="bi bi-journal-check"></i>
                </div>
                <div class="stat-info">
                    <div class="stat-number">@Model.ActiveBorrowsCount</div>
                    <div class="stat-label">Active Borrows</div>
                </div>
            </div>
        </div>

        <!-- 3. Overdue Items -->
        <div class="col-xl-3 col-md-6 col-12">
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(200,121,65,0.12); color:var(--damaged);">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div class="stat-info">
                    <div class="stat-number text-danger">@Model.OverdueLoansCount</div>
                    <div class="stat-label">Overdue Items</div>
                </div>
            </div>
        </div>

        <!-- 4. Fine Revenue This Year -->
        <div class="col-xl-3 col-md-6 col-12">
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(192,57,43,0.12); color:var(--destroyed);">
                    <i class="bi bi-cash-coin"></i>
                </div>
                <div class="stat-info">
                    <div class="stat-number" style="color:var(--available);">$@Model.FineRevenueCollected.ToString("N2")</div>
                    <div class="stat-label">Fine Revenue This Year</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 2: Chart.js Visualizations (Side by Side on Desktop) -->
    <div class="row g-4 mb-4">
        <!-- Chart 1: Item Status Distribution (Doughnut) -->
        <div class="col-lg-6 col-12">
            <div class="lib-card h-100">
                <div class="lib-card-header d-flex align-items-center gap-2">
                    <i class="bi bi-pie-chart text-success fs-5"></i>
                    <h3 class="mb-0">Item Status Distribution</h3>
                </div>
                <div style="position: relative; height: 300px;">
                    <canvas id="statusChart"></canvas>
                </div>
                <div class="d-flex flex-wrap justify-content-center gap-2 mt-3 pt-3 border-top">
                    <span class="status-badge status-available">Available: @Model.AvailableItemsCount</span>
                    <span class="status-badge status-borrowed">Borrowed: @Model.BorrowedItemsCount</span>
                    <span class="status-badge status-damaged">Damaged: @Model.DamagedItemsCount</span>
                    <span class="status-badge status-destroyed">Destroyed: @Model.DestroyedItemsCount</span>
                </div>
            </div>
        </div>

        <!-- Chart 2: Loans by Category Bar Chart (Jan - Dec) -->
        <div class="col-lg-6 col-12">
            <div class="lib-card h-100">
                <div class="lib-card-header d-flex align-items-center gap-2">
                    <i class="bi bi-bar-chart text-primary fs-5"></i>
                    <h3 class="mb-0">Loans by Category This Year</h3>
                </div>
                <div style="position: relative; height: 300px;">
                    <canvas id="loansChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 3: Fine Revenue vs Damage Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-12">
            <div class="lib-card h-100 p-4 border-start border-success border-4">
                <div class="text-muted small text-uppercase fw-bold mb-1">Fine Revenue This Year</div>
                <div class="fs-1 fw-bold" style="font-family:'Playfair Display', serif; color:var(--available);">
                    $@Model.FineRevenueCollected.ToString("N2")
                </div>
                <p class="text-muted small mb-0 mt-2">
                    <i class="bi bi-check-circle me-1 text-success"></i>Total collected late returns and condition penalties.
                </p>
            </div>
        </div>
        <div class="col-md-6 col-12">
            <div class="lib-card h-100 p-4 border-start border-warning border-4">
                <div class="text-muted small text-uppercase fw-bold mb-1">Items Needing Attention</div>
                <div class="fs-1 fw-bold" style="font-family:'Playfair Display', serif; color:var(--damaged);">
                    @Model.DamagedAndDestroyedItems.Count items
                </div>
                <p class="text-muted small mb-0 mt-2">
                    <i class="bi bi-exclamation-triangle me-1 text-warning"></i>Total replacement liability: <strong>$@Model.DamageLiabilityCost.ToString("N2")</strong>
                </p>
            </div>
        </div>
    </div>

    <!-- Table 1: Top 5 Most Borrowed Items -->
    <div class="lib-card mb-4">
        <div class="lib-card-header d-flex align-items-center gap-2">
            <i class="bi bi-trophy text-warning fs-5"></i>
            <h3 class="mb-0">Most Borrowed Items</h3>
        </div>

        @if (!Model.TopBorrowedItems.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox" style="font-size: 3rem; color: var(--muted);"></i>
                <h5 class="mt-3">No borrowing history yet</h5>
                <p class="text-muted small">Items will appear here once checked out by patrons.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="lib-table mb-0">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Rank</th>
                            <th>Item Name</th>
                            <th>Type</th>
                            <th>Total Times Borrowed</th>
                            <th>Last Borrowed Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rank = 1; }
                        @foreach (var top in Model.TopBorrowedItems)
                        {
                            var typeClass = top.ItemType switch
                            {
                                LibraTrack.Models.ItemType.Book => "type-book",
                                LibraTrack.Models.ItemType.Music => "type-music",
                                LibraTrack.Models.ItemType.Toy => "type-toy",
                                _ => "type-book"
                            };

                            <tr>
                                <td>
                                    @if (rank == 1)
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-award-fill"></i> #1</span>
                                    }
                                    else if (rank == 2)
                                    {
                                        <span class="badge bg-secondary">#2</span>
                                    }
                                    else if (rank == 3)
                                    {
                                        <span class="badge bg-dark">#3</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fw-bold">#@rank</span>
                                    }
                                </td>
                                <td>
                                    <strong>@top.Name</strong>
                                    <div class="text-muted small font-monospace">@top.LibraryCode</div>
                                </td>
                                <td>
                                    <span class="type-badge @typeClass">@top.ItemType</span>
                                </td>
                                <td>
                                    <span class="badge bg-primary fs-6">@top.BorrowCount checkouts</span>
                                </td>
                                <td>
                                    @(top.LastBorrowedDate.HasValue ? top.LastBorrowedDate.Value.ToString("dd MMM yyyy") : "—")
                                </td>
                            </tr>
                            rank++;
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Table 2: Damaged & Destroyed Items Audit -->
    <div class="lib-card">
        <div class="lib-card-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle text-danger fs-5"></i>
                <h3 class="mb-0">Items Requiring Attention</h3>
            </div>
            <span class="badge bg-danger">@Model.DamagedAndDestroyedItems.Count items</span>
        </div>

        @if (!Model.DamagedAndDestroyedItems.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
                <h5 class="mt-3 text-success">All items are in good condition</h5>
                <p class="text-muted small">No items currently reported damaged or destroyed.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="lib-table mb-0">
                    <thead>
                        <tr>
                            <th>Library Code</th>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Date Added</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.DamagedAndDestroyedItems)
                        {
                            var typeClass = item.ItemType switch
                            {
                                LibraTrack.Models.ItemType.Book => "type-book",
                                LibraTrack.Models.ItemType.Music => "type-music",
                                LibraTrack.Models.ItemType.Toy => "type-toy",
                                _ => "type-book"
                            };

                            var statusClass = item.Status switch
                            {
                                LibraTrack.Models.ItemStatus.Damaged => "status-damaged",
                                LibraTrack.Models.ItemStatus.Destroyed => "status-destroyed",
                                _ => "status-damaged"
                            };

                            <tr>
                                <td><span class="badge bg-light text-dark border font-monospace">@item.LibraryCode</span></td>
                                <td><strong>@item.Name</strong></td>
                                <td><span class="type-badge @typeClass">@item.ItemType</span></td>
                                <td><span class="status-badge @statusClass">@item.Status</span></td>
                                <td>@item.CreatedAt.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Chart 1: Item Status Distribution (Doughnut)
            var statusCanvas = document.getElementById('statusChart');
            if (statusCanvas) {
                new Chart(statusCanvas, {
                    type: 'doughnut',
                    data: {
                        labels: ['Available', 'Borrowed', 'Damaged', 'Destroyed'],
                        datasets: [{
                            data: [
                                @Model.AvailableItemsCount,
                                @Model.BorrowedItemsCount,
                                @Model.DamagedItemsCount,
                                @Model.DestroyedItemsCount
                            ],
                            backgroundColor: ['#4A7C59', '#2E6DA4', '#C87941', '#C0392B'],
                            borderWidth: 3,
                            borderColor: '#FAF7F2',
                            hoverBorderWidth: 0,
                            hoverOffset: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '65%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    padding: 20,
                                    usePointStyle: true,
                                    pointStyleWidth: 10,
                                    font: { family: 'Lato', size: 13 }
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                        const percentage = total > 0 ? ((context.parsed / total) * 100).toFixed(1) : 0;
                                        return ` ${context.label}: ${context.parsed} items (${percentage}%)`;
                                    }
                                }
                            }
                        },
                        animation: {
                            animateRotate: true,
                            duration: 800
                        }
                    }
                });
            }

            // Chart 2: Loans by Category This Year (Bar Chart)
            var loansCanvas = document.getElementById('loansChart');
            if (loansCanvas) {
                new Chart(loansCanvas, {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthsLabels)),
                        datasets: [
                            {
                                label: 'Books',
                                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyBookLoans)),
                                backgroundColor: 'rgba(46,109,164,0.8)',
                                borderColor: '#2E6DA4',
                                borderWidth: 2,
                                borderRadius: 6,
                                borderSkipped: false
                            },
                            {
                                label: 'Music',
                                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyMusicLoans)),
                                backgroundColor: 'rgba(123,79,166,0.8)',
                                borderColor: '#7B4FA6',
                                borderWidth: 2,
                                borderRadius: 6,
                                borderSkipped: false
                            },
                            {
                                label: 'Toys',
                                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyToyLoans)),
                                backgroundColor: 'rgba(212,131,26,0.8)',
                                borderColor: '#D4831A',
                                borderWidth: 2,
                                borderRadius: 6,
                                borderSkipped: false
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false
                        },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: {
                                    usePointStyle: true,
                                    pointStyleWidth: 10,
                                    font: { family: 'Lato', size: 13 },
                                    padding: 20
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    footer: function(tooltipItems) {
                                        const total = tooltipItems.reduce((sum, item) => sum + item.parsed.y, 0);
                                        return 'Total: ' + total + ' loans';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: { font: { family: 'Lato', size: 12 } }
                            },
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    stepSize: 1,
                                    font: { family: 'Lato', size: 12 }
                                },
                                grid: {
                                    color: 'rgba(0,0,0,0.05)'
                                }
                            }
                        },
                        animation: {
                            duration: 800,
                            easing: 'easeInOutQuart'
                        }
                    }
                });
            }
        });
    </script>
}
