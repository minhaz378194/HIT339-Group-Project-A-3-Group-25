@model LibraTrack.Models.ViewModels.TransferListViewModel
@{
    ViewData["Title"] = "Multi-Branch Item Transfers";
    var filter = Model.ActiveFilter ?? "all";
}

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Catalog" asp-action="Index"><i class="bi bi-house"></i></a></li>
                <li class="breadcrumb-item active">Inventory Transfers</li>
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h1 class="page-title mb-1">
                    <i class="bi bi-truck text-primary me-2"></i>Multi-Branch Transfers
                </h1>
                <p class="text-muted small mb-0">Track and manage inter-library logistics, item relocation, and branch stock redistribution.</p>
            </div>
            <a asp-action="Create" class="btn btn-lib-primary">
                <i class="bi bi-plus-circle me-1"></i>New Transfer Request
            </a>
        </div>
    </div>
</div>

<div class="container pb-5">
    <!-- Filter Bar & Search -->
    <div class="row g-3 mb-4 align-items-center">
        <div class="col-lg-7">
            <div class="btn-group flex-wrap" role="group">
                <a asp-action="Index" asp-route-status="all" class="btn @(filter == "all" ? "btn-dark" : "btn-outline-dark")">
                    All <span class="badge bg-secondary ms-1">@Model.TotalCount</span>
                </a>
                <a asp-action="Index" asp-route-status="requested" class="btn @(filter == "requested" ? "btn-info text-white" : "btn-outline-info")">
                    <i class="bi bi-clock-history me-1"></i>Requested <span class="badge bg-light text-dark ms-1">@Model.RequestedCount</span>
                </a>
                <a asp-action="Index" asp-route-status="intransit" class="btn @(filter == "intransit" ? "btn-warning text-dark" : "btn-outline-warning")">
                    <i class="bi bi-truck me-1"></i>In Transit <span class="badge bg-dark text-white ms-1">@Model.InTransitCount</span>
                </a>
                <a asp-action="Index" asp-route-status="received" class="btn @(filter == "received" ? "btn-success" : "btn-outline-success")">
                    <i class="bi bi-check-circle-fill me-1"></i>Received <span class="badge bg-light text-dark ms-1">@Model.ReceivedCount</span>
                </a>
                <a asp-action="Index" asp-route-status="cancelled" class="btn @(filter == "cancelled" ? "btn-secondary" : "btn-outline-secondary")">
                    Cancelled
                </a>
            </div>
        </div>
        <div class="col-lg-5">
            <form method="get" asp-action="Index" class="d-flex gap-2">
                <input type="hidden" name="status" value="@filter" />
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search item, code, or branch..." />
                <button type="submit" class="btn btn-lib-primary"><i class="bi bi-search me-1"></i>Search</button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <a asp-action="Index" asp-route-status="@filter" class="btn btn-outline-secondary">Clear</a>
                }
            </form>
        </div>
    </div>

    @if (!Model.Transfers.Any())
    {
        <div class="lib-card text-center py-5">
            <i class="bi bi-truck fs-1 text-muted d-block mb-3"></i>
            <h5>No Transfers Found</h5>
            <p class="text-muted small">No inter-branch transfers match the selected filter criteria.</p>
            <a asp-action="Create" class="btn btn-lib-primary mt-2">
                <i class="bi bi-plus-circle me-1"></i>Create First Transfer Request
            </a>
        </div>
    }
    else
    {
        <div class="lib-card p-0 overflow-hidden shadow-sm">
            <div class="table-responsive">
                <table class="lib-table mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 80px;">Ref #</th>
                            <th>Item Details</th>
                            <th>Transfer Route</th>
                            <th>Status</th>
                            <th>Requested</th>
                            <th>Completed</th>
                            <th>Notes</th>
                            <th class="text-end" style="min-width: 170px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var transfer in Model.Transfers)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-secondary font-monospace">#TRF-@transfer.Id.ToString("D4")</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(transfer.Item.ImageUrl))
                                        {
                                            <img src="@transfer.Item.ImageUrl" alt="@transfer.Item.Name" class="rounded me-2" style="width: 38px; height: 38px; object-fit: cover;" onerror="this.style.display='none'" />
                                        }
                                        <div>
                                            <a asp-controller="Catalog" asp-action="Details" asp-route-id="@transfer.Item.Id" class="fw-bold text-decoration-none text-dark">
                                                @transfer.Item.Name
                                            </a>
                                            <div class="small text-muted font-monospace">@transfer.Item.LibraryCode</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-building me-1"></i>@transfer.FromBranch.Name
                                        </span>
                                        <i class="bi bi-arrow-right text-primary"></i>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                            <i class="bi bi-geo-alt-fill me-1"></i>@transfer.ToBranch.Name
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    @switch (transfer.Status)
                                    {
                                        case LibraTrack.Models.TransferStatus.Requested:
                                            <span class="badge bg-info text-white px-2 py-1"><i class="bi bi-clock me-1"></i>Requested</span>
                                            break;
                                        case LibraTrack.Models.TransferStatus.InTransit:
                                            <span class="badge bg-warning text-dark px-2 py-1"><i class="bi bi-truck me-1"></i>In Transit</span>
                                            break;
                                        case LibraTrack.Models.TransferStatus.Received:
                                            <span class="badge bg-success px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i>Received</span>
                                            break;
                                        case LibraTrack.Models.TransferStatus.Cancelled:
                                            <span class="badge bg-secondary px-2 py-1"><i class="bi bi-x-circle me-1"></i>Cancelled</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <div class="small text-dark">@transfer.RequestedAt.ToString("dd MMM yyyy")</div>
                                    <div class="small text-muted">by @(transfer.RequestedByUser?.FullName ?? "Staff")</div>
                                </td>
                                <td>
                                    @if (transfer.CompletedAt.HasValue)
                                    {
                                        <span class="small text-muted">@transfer.CompletedAt.Value.ToString("dd MMM yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">&mdash;</span>
                                    }
                                </td>
                                <td>
                                    <span class="small text-muted" title="@transfer.Notes">
                                        @(string.IsNullOrWhiteSpace(transfer.Notes) ? "—" : (transfer.Notes.Length > 30 ? transfer.Notes.Substring(0, 30) + "…" : transfer.Notes))
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1 justify-content-end">
                                        @if (transfer.Status == LibraTrack.Models.TransferStatus.Requested)
                                        {
                                            <form asp-action="MarkInTransit" asp-route-id="@transfer.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-warning" title="Dispatch and mark in transit">
                                                    <i class="bi bi-truck me-1"></i>Dispatch
                                                </button>
                                            </form>
                                            <form asp-action="Cancel" asp-route-id="@transfer.Id" method="post" class="d-inline" onsubmit="return confirm('Cancel this transfer request?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Cancel request">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                        }
                                        else if (transfer.Status == LibraTrack.Models.TransferStatus.InTransit)
                                        {
                                            <form asp-action="MarkReceived" asp-route-id="@transfer.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success" title="Confirm receipt at destination branch">
                                                    <i class="bi bi-check2-circle me-1"></i>Receive
                                                </button>
                                            </form>
                                            <form asp-action="Cancel" asp-route-id="@transfer.Id" method="post" class="d-inline" onsubmit="return confirm('Cancel this in-transit transfer?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Cancel transfer">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">Completed</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
