@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LibraTrack</title>
    
    <!-- Google Fonts: Playfair Display + Lato -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap Icons 1.11.3 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Library Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/library-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Main Top Navigation -->
    <header>
        <nav class="navbar navbar-expand-lg sticky-top">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Catalog" asp-action="Index">
                    <i class="bi bi-book-half me-2"></i>Libra<span>Track</span>
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" 
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2 text-light"></i>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Catalog" ? "active" : "")" 
                               asp-controller="Catalog" asp-action="Index">
                                <i class="bi bi-compass me-1"></i>Explore Catalog
                            </a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Items" || ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")" 
                                       asp-controller="Items" asp-action="Index">
                                        <i class="bi bi-shield-check me-1"></i>Admin Dashboard
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Reception"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Borrowers" || ViewContext.RouteData.Values["controller"]?.ToString() == "Reception" ? "active" : "")" 
                                       asp-controller="Borrowers" asp-action="Index">
                                        <i class="bi bi-people me-1"></i>Borrowers
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Loans" ? "active" : "")" 
                                       asp-controller="Loans" asp-action="Index">
                                        <i class="bi bi-arrow-left-right me-1"></i>Loans & Fines
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Manager"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Manager" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" 
                                       asp-controller="Manager" asp-action="Index">
                                        <i class="bi bi-graph-up me-1"></i>Manager Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Manager" && ViewContext.RouteData.Values["action"]?.ToString() == "Statistics" ? "active" : "")" 
                                       asp-controller="Manager" asp-action="Statistics">
                                        <i class="bi bi-graph-up-arrow me-1"></i>Borrowing Statistics
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "Staff";
                            var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name;

                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-light dropdown-toggle d-flex align-items-center py-1 px-3" 
                                        type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false" 
                                        style="border-color: var(--caramel); background: rgba(255,255,255,0.08);">
                                    <i class="bi bi-person-circle me-2 fs-6"></i>
                                    <span class="d-none d-md-inline me-2">@fullName</span>
                                    <span class="badge rounded-pill ms-2" style="background:var(--caramel);font-size:0.75rem;">@role</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg" aria-labelledby="userMenuDropdown" style="background:var(--white); border-color:var(--border);">
                                    <li class="dropdown-header text-muted small">Signed in as <strong>@User.Identity.Name</strong></li>
                                    <li><hr class="dropdown-divider"></li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Items" asp-action="Index"><i class="bi bi-shield-check me-2"></i>Admin Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-controller="Items" asp-action="CreateBook"><i class="bi bi-journal-plus me-2"></i>Add Book</a></li>
                                        <li><a class="dropdown-item" asp-controller="Items" asp-action="CreateMusic"><i class="bi bi-disc me-2"></i>Add Music</a></li>
                                        <li><a class="dropdown-item" asp-controller="Items" asp-action="CreateToy"><i class="bi bi-puzzle me-2"></i>Add Toy</a></li>
                                    }
                                    @if (User.IsInRole("Reception"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Borrowers" asp-action="Index"><i class="bi bi-person-badge me-2"></i>Reception Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-controller="Borrowers" asp-action="Create"><i class="bi bi-person-plus me-2"></i>Register Borrower</a></li>
                                        <li><a class="dropdown-item" asp-controller="Loans" asp-action="Issue"><i class="bi bi-box-arrow-up-right me-2"></i>Issue Item</a></li>
                                        <li><a class="dropdown-item" asp-controller="Loans" asp-action="Index"><i class="bi bi-arrow-return-left me-2"></i>Returns & Fines</a></li>
                                    }
                                    @if (User.IsInRole("Manager"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Manager" asp-action="Index"><i class="bi bi-graph-up me-2"></i>Manager Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-controller="Manager" asp-action="Statistics"><i class="bi bi-graph-up-arrow me-2"></i>Full Statistics</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn-nav-staff" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-shield-lock-fill me-1"></i>Staff Portal
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Toast Notification Container (Section 17 of design.md) -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
        @if (TempData["Success"] != null)
        {
            <div class="toast align-items-center text-white border-0 show shadow-lg" style="background:var(--available);" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-check-circle-fill me-2 fs-5"></i>@TempData["Success"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="toast align-items-center text-white border-0 show shadow-lg" style="background:var(--destroyed);" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>@TempData["Error"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
    </div>

    <!-- Body Content Area -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Academic Footer (Section 15 of design.md) -->
    <footer class="lib-footer">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span>
                    <i class="bi bi-book-half me-1"></i>
                    <strong>LibraTrack</strong> &copy; 2025 — Library Management System
                </span>
                <span style="color:var(--muted);font-size:0.85rem;">
                    Built with ASP.NET Core MVC
                </span>
            </div>
        </div>
    </footer>

    <!-- Bootstrap & Chart.js Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        // Auto-hide toasts after 5 seconds
        document.addEventListener("DOMContentLoaded", function () {
            var toastElList = [].slice.call(document.querySelectorAll('.toast'));
            var toastList = toastElList.map(function (toastEl) {
                return new bootstrap.Toast(toastEl, { delay: 5000 });
            });
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
